${LangFileString} MUI_UNTEXT_CONFIRM_SUBTITLE "Ka saar $(^NameDA) kombiyuutarkaaga."
${LangFileString} MUI_TEXT_ABORTWARNING "Ma hubtaa inaad rabto inaad ka baxdo $(^Name) Dejinta?"
