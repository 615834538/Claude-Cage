!insertmacro LANGFILE "Somali" "Soomaali" "Somali" "Somali"

${LangFileString} MUI_TEXT_WELCOME_INFO_TITLE "Ku soo dhawoow dejinta $(^NameDA)."
${LangFileString} MUI_TEXT_WELCOME_INFO_TEXT "Setup will guide you through the installation of $(^NameDA).$\r$\n$\r$\nIt is recommended that you close all other applications before starting Setup. This will make it possible to update relevant system files without having to reboot your computer.$\r$\n$\r$\n$_CLICK"
${LangFileString} MUI_TEXT_LICENSE_TITLE "Heshiiska shatiga"
${LangFileString} MUI_TEXT_LICENSE_SUBTITLE "Fadlan dib u eeg shuruudaha shatiga ka hor intaadan rakibin $(^NameDA)."
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM "Haddii aad aqbasho shuruudaha heshiiska, dhagsii I Agree si aad u sii wadato. Waa inaad aqbashaa heshiiska lagu rakibayo $(^NameDA)."
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM_CHECKBOX "Haddii aad aqbasho shuruudaha heshiiska, dhagsii sanduuqa calaamadaynta ee hoose. Waa inaad aqbashaa heshiiska lagu rakibayo $(^NameDA). $_CLICK"
${LangFileString} MUI_INNERTEXT_LICENSE_BOTTOM_RADIOBUTTONS "Haddii aad aqbasho shuruudaha heshiiska, dooro doorashada koowaad ee hoose. Waa inaad aqbashaa heshiiska lagu rakibayo $(^NameDA). $_CLICK"
${LangFileString} MUI_INNERTEXT_LICENSE_TOP "Riix Bogga Hoose si aad u aragto inta ka hartay heshiiska."
${LangFileString} MUI_TEXT_DIRECTORY_TITLE "Dooro Goobta Ku rakib"
${LangFileString} MUI_TEXT_DIRECTORY_SUBTITLE "Dooro galka aad ku rakibayso $(^NameDA)."
${LangFileString} MUI_TEXT_INSTALLING_TITLE "Rakibaadda"
${LangFileString} MUI_TEXT_INSTALLING_SUBTITLE "Fadlan sug inta $(^NameDA) la rakibayo."
${LangFileString} MUI_TEXT_FINISH_TITLE "Rakibadihii wuu Dhamaaday"
${LangFileString} MUI_TEXT_FINISH_SUBTITLE "Dejinta si guul leh ayay u dhammaatay"
${LangFileString} MUI_TEXT_ABORT_TITLE "Rakibaddii waa la iska tuuray"
${LangFileString} MUI_TEXT_ABORT_SUBTITLE "Dejinta si guul leh looguma dhammayn"
${LangFileString} MUI_UNTEXT_UNINSTALLING_TITLE "Dejinta"
${LangFileString} MUI_UNTEXT_UNINSTALLING_SUBTITLE "Fadlan sug inta $(^NameDA) la furayo"
${LangFileString} MUI_UNTEXT_FINISH_TITLE "Soo saaristii oo dhamaystiran"
${LangFileString} MUI_UNTEXT_FINISH_SUBTITLE "Uninstall-ka ayaa lagu dhameeyay si guul leh"
${LangFileString} MUI_UNTEXT_ABORT_TITLE "Ka saarista waa la iska tuuray"
${LangFileString} MUI_UNTEXT_ABORT_SUBTITLE "Uninstall-ka looma dhammayn si guul leh"
${LangFileString} MUI_TEXT_FINISH_INFO_TITLE "Dejinta $(^NameDA) dhammaystiraysa"
${LangFileString} MUI_TEXT_FINISH_INFO_TEXT "$(^NameDA) has been installed on your computer.$\r$\n$\r$\nClick Finish to close Setup."
${LangFileString} MUI_TEXT_FINISH_INFO_REBOOT "Kumbuyuutarkaaga waa in dib loo bilaabo si loo dhamaystiro rakibaadda $(^NameDA). Ma rabtaa in aad hadda dib u kiciso?"
${LangFileString} MUI_TEXT_FINISH_REBOOTNOW "Hadda dib u bilow"
${LangFileString} MUI_TEXT_FINISH_REBOOTLATER "Waxaan rabaa in aan gacanta dib u bilaabo hadhow"
